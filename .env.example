# Authentication Secret (Must match backend AUTH_SECRET)
AUTH_SECRET=replace-with-a-long-random-jwt-secret

# Backend API Endpoint URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Zero to Code Student Registration Google Form URL
NEXT_PUBLIC_STUDENT_FORM_URL=https://forms.gle/ugWPdQQ9LrWYxe9w7

# Public base URL for course metadata only (no trailing slash).
# Use a separate public bucket/domain; the video bucket configured in the
# backend must remain private.
R2_PUBLIC_URL=https://course-metadata.example.com

# JSON course manifest path inside the public metadata bucket
R2_COURSE_MANIFEST_KEY=courses/zero-to-code/manifest.json
